// Cloudflareデプロイ設定（hogen.mainichi-lab.com）
{
  "name": "hogen-lab",
  // 🔴 OpenNext の .open-next/worker.js を直接指さない。
  // worker-entry.ts がそれをエッジキャッシュで包む（理由はファイル冒頭のコメント）。
  // ビルドで .open-next/ が作り直されてもこのラッパーは残る。
  "main": "worker-entry.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "hogen.mainichi-lab.com", "custom_domain": true }
  ],
  // デプロイごとに一意なIDが取れる。キャッシュキーに混ぜて「デプロイ＝自動総入れ替え」にする
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // 「一言」ボックス（/api/voice）の受け皿。2026-09-07 新設。
  // 外部フォーム事業者を使わず自分のCloudflareアカウントに置く。個人情報は保存しない
  "kv_namespaces": [
    { "binding": "VOICE", "id": "204296042b4e4b16aae30fbe46c34494" }
  ],
  // Workers Logs（cpuTime / outcome を後から検索できる）。2026-09-26 の 503 障害で、
  // `wrangler tail` は **プレビューURL（wrangler versions upload）への流入を拾えない**ことが
  // 実測で分かったため、昇格前に CPU を測る手段として有効化した。
  // Free プランの範囲内（200k イベント/日）。個人情報は載らない（URLとステータスのみ）。
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Search Console検証ファイル等の .html をリダイレクトさせずそのまま配信
    "html_handling": "none"
  }
}
