// Cloudflareデプロイ設定（hogen.mainichi-lab.com 予定）
{
  "name": "hogen-lab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "hogen.mainichi-lab.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Search Console検証ファイル等の .html をリダイレクトさせずそのまま配信
    "html_handling": "none"
  }
}
